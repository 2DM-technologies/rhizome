{
  "name": "rhizome",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*",
    "dmachines/*"
  ],
  "scripts": {
    "dev": "bun --filter @rhizome/server --filter @rhizome/host dev",
    "dev:server": "bun --filter @rhizome/server dev",
    "dev:host": "bun --filter @rhizome/host dev",
    "dev:s3": "bun run apps/server/scripts/dev-s3.ts",
    "db:migrate": "bun run apps/server/src/db/migrate.ts",
    "db:seed": "bun run apps/server/src/db/seedDb.ts",
    "openapi:generate": "bun run scripts/generate-host-openapi.ts",
    "openapi:check": "bun run scripts/generate-host-openapi.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun --filter @rhizome/host test:e2e",
    "check:m15": "bun run check && bun run test:e2e",
    "build": "bun --filter '*' build",
    "check": "bun run openapi:check && bun run format:check && bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.214.0",
    "@rnet/types": "file:../rnet/packages/types",
    "@zip.js/zip.js": "2.8.61",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "@rhizome/test-support": "workspace:*"
  }
}
