{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    "noEmit": true
  },
  "include": [
    "scripts/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/*/.storybook/**/*.ts",
    "apps/*/.storybook/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
