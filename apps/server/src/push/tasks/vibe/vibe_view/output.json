{
  "type": "object",
  "additionalProperties": false,
  "required": ["view", "config"],
  "properties": {
    "view": { "type": "string", "enum": ["datatable", "mediaboard", "simplelist"] },
    "config": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "sort"],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "string", "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$" }
            },
            "sort": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pointer", "direction"],
                  "properties": {
                    "pointer": { "type": "string", "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$" },
                    "direction": { "type": "string", "enum": ["asc", "desc"] }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption_pointer"],
          "properties": {
            "caption_pointer": {
              "anyOf": [
                { "type": "string", "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subtitle_pointer"],
          "properties": {
            "subtitle_pointer": {
              "anyOf": [
                { "type": "string", "pattern": "^(/[^/~]*(~[01][^/~]*)*)+$" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    }
  }
}
