{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tags", "confidence"],
  "properties": {
    "summary": { "type": "string", "pattern": "^[\\s\\S]{1,600}$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
