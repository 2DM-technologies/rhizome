{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "seed", "palette", "contrast", "field", "energy", "confidence"],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "seed": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "palette": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["color", "weight"],
        "properties": {
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "contrast": { "type": "number", "minimum": 0, "maximum": 1 },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grain", "warp", "anisotropy"],
      "properties": {
        "grain": { "type": "number", "minimum": 0, "maximum": 1 },
        "warp": { "type": "number", "minimum": 0, "maximum": 1 },
        "anisotropy": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "energy": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
