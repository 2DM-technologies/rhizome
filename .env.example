DATABASE_URL=postgres://localhost/rhizome
RHIZOME_AUTH_MODE=dev
RHIZOME_BASE_URL=http://127.0.0.1:3000
# The host dev server is a separate origin, so it needs to be allowed explicitly.
RHIZOME_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173
RHIZOME_MAX_REQUEST_BODY_BYTES=52428800

# Development generates a private, gitignored .rhizome/source-credential.key on first use.
# Production uses the workload's standard AWS credential chain. The encryption key must be a
# symmetric ENCRYPT_DECRYPT KMS key; HMAC ids are immutable HMAC_256 key ids/ARNs (never aliases),
# active first, then prior enabled keys retained for as long as their claim fingerprints exist.
# AWS_REGION=us-east-1
# RHIZOME_CREDENTIAL_KMS_KEY_ID=alias/rhizome-credential-encryption
# RHIZOME_CREDENTIAL_KMS_HMAC_KEY_IDS=arn:aws:kms:us-east-1:123456789012:key/immutable-hmac-key-id
# RHIZOME_CREDENTIAL_KMS_TIMEOUT_MS=5000
# Local keys remain available outside production. The legacy keyring is an explicit v1/v2 read
# fallback and preserves token-fingerprint overlap during a rolling local-to-KMS deployment.
# RHIZOME_CREDENTIAL_ENCRYPTION_KEY=
# RHIZOME_CREDENTIAL_KEYRING={"active":"2026-08","keys":{"2026-08":"base64-key","2026-07":"base64-key"}}
# RHIZOME_CREDENTIAL_LEGACY_KEYRING={"active":"2026-08","keys":{"2026-08":"base64-key"}}
# RHIZOME_SIMPLEFIN_ALLOWED_HOSTS=bridge.simplefin.org,beta-bridge.simplefin.org

# Object storage. These defaults point at the local emulator `bun run dev:s3` starts;
# replace them with a real R2 bucket's endpoint and credentials to run against R2.
R2_ENDPOINT=http://localhost:4568
R2_ACCESS_KEY_ID=S3RVER
R2_SECRET_ACCESS_KEY=S3RVER
R2_FORCE_PATH_STYLE=true
R2_ELEMENTS_BUCKET=elements
R2_ORIGINS_BUCKET=origins
R2_BUNDLES_BUCKET=bundles
R2_ASSETS_BUCKET=assets

VITE_RHIZOME_API_URL=http://localhost:3000
