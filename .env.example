DATABASE_URL=postgres://localhost/rhizome
RHIZOME_AUTH_MODE=dev
RHIZOME_BASE_URL=http://localhost:3000
# The host dev server is a separate origin, so it needs to be allowed explicitly.
RHIZOME_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RHIZOME_MAX_REQUEST_BODY_BYTES=52428800

# Object storage. These defaults point at the local emulator `bun run dev:s3` starts;
# replace them with a real R2 bucket's endpoint and credentials to run against R2.
R2_ENDPOINT=http://localhost:4568
R2_ACCESS_KEY_ID=S3RVER
R2_SECRET_ACCESS_KEY=S3RVER
R2_FORCE_PATH_STYLE=true
R2_ELEMENTS_BUCKET=elements
R2_ORIGINS_BUCKET=origins
R2_BUNDLES_BUCKET=bundles
R2_ASSETS_BUCKET=assets

VITE_RHIZOME_API_URL=http://localhost:3000
